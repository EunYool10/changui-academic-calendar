rules_version = '2';

// 학사 달력: 누구나 일정을 읽고, staff/{uid} 문서에 role 'admin'이 있는 계정만 일정을 고칩니다.
// staff 문서는 클라이언트에서 만들 수 없고, 프로젝트 소유자가 콘솔이나 서버 도구로만 추가합니다.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/staff/$(request.auth.uid))
        && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role == 'admin';
    }

    function isDate(v) {
      return v is string && v.matches('^20[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$');
    }

    function validEvent(d) {
      return d.keys().hasAll(['start', 'end', 'title', 'category'])
        && d.keys().hasOnly(['start', 'end', 'title', 'category', 'updatedAt'])
        && isDate(d.start) && isDate(d.end) && d.start <= d.end
        && d.title is string && d.title.size() > 0 && d.title.size() <= 100
        && d.category in ['school', 'exam', 'holiday']
        && (!('updatedAt' in d) || d.updatedAt is timestamp);
    }

    match /events/{eventId} {
      allow read: if true;
      allow create, update: if isAdmin() && validEvent(request.resource.data);
      allow delete: if isAdmin();
    }

    // meta/site.updatedAt: 일정을 추가·수정·삭제할 때마다 관리자가 남기는 마지막 수정 시각(바닥글 표시용)
    match /meta/{docId} {
      allow read: if true;
      allow create, update: if isAdmin() && docId == 'site'
        && request.resource.data.keys().hasOnly(['updatedAt'])
        && request.resource.data.updatedAt is timestamp;
      allow delete: if false;
    }

    match /staff/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
